{
  "manifest_version": 3,
  "name": "Spool: Video & Stream Downloader",
  "version": "0.1.0",
  "description": "Save the video you're watching: direct files and HLS streams, converted to MP4. Runs locally. No DRM bypass.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Spool",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "webRequest",
    "webNavigation",
    "downloads",
    "storage",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
